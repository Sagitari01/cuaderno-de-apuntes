<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_asis" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="C_asis">
<bpmn:participant id="P_sol" name="Persona solicitante"/>
<bpmn:participant id="P_cen" name="Centro comunitario" processRef="Proc_asis"/>
<bpmn:messageFlow id="m1" name="Solicitud" sourceRef="P_sol" targetRef="S"/><bpmn:messageFlow id="m2" name="Pide aclaración" sourceRef="TA" targetRef="P_sol"/><bpmn:messageFlow id="m3" name="Envía los datos" sourceRef="P_sol" targetRef="T1"/><bpmn:messageFlow id="m4" name="Confirmación o rechazo" sourceRef="T4" targetRef="P_sol"/>
</bpmn:collaboration>
<bpmn:process id="Proc_asis" isExecutable="false">
<bpmn:laneSet id="LS_asis"><bpmn:lane id="L1" name="Encargada de reservas"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>TA</bpmn:flowNodeRef><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>G2</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>G3</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="S" name="Llega solicitud por correo"/>
<bpmn:task id="T1" name="Revisar solicitud y datos"/>
<bpmn:exclusiveGateway id="G1" name="¿Datos completos?"/>
<bpmn:task id="TA" name="Pedir aclaración y esperar respuesta"/>
<bpmn:task id="T2" name="Consultar planilla de disponibilidad"/>
<bpmn:exclusiveGateway id="G2" name="¿Equipo disponible?"/>
<bpmn:task id="T3" name="Anotar la reserva"/>
<bpmn:exclusiveGateway id="G3"/>
<bpmn:task id="T4" name="Redactar y enviar respuesta"/>
<bpmn:endEvent id="E" name="Reserva confirmada o rechazada"/>
<bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="T1"/>
<bpmn:sequenceFlow id="f2" sourceRef="T1" targetRef="G1"/>
<bpmn:sequenceFlow id="f3" sourceRef="G1" targetRef="TA" name="No"/>
<bpmn:sequenceFlow id="f4" sourceRef="TA" targetRef="T1"/>
<bpmn:sequenceFlow id="f5" sourceRef="G1" targetRef="T2" name="Sí"/>
<bpmn:sequenceFlow id="f6" sourceRef="T2" targetRef="G2"/>
<bpmn:sequenceFlow id="f7" sourceRef="G2" targetRef="T3" name="Sí"/>
<bpmn:sequenceFlow id="f8" sourceRef="G2" targetRef="G3" name="No"/>
<bpmn:sequenceFlow id="f9" sourceRef="T3" targetRef="G3"/>
<bpmn:sequenceFlow id="f10" sourceRef="G3" targetRef="T4"/>
<bpmn:sequenceFlow id="f11" sourceRef="T4" targetRef="E"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="D_asis"><bpmndi:BPMNPlane id="Pl_asis" bpmnElement="C_asis">
<bpmndi:BPMNShape id="P_sol_di" bpmnElement="P_sol" isHorizontal="true"><dc:Bounds x="160" y="40" width="1265" height="60"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="P_cen_di" bpmnElement="P_cen" isHorizontal="true"><dc:Bounds x="160" y="200" width="1265" height="340"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="L1_di" bpmnElement="L1" isHorizontal="true"><dc:Bounds x="190" y="200" width="1235" height="340"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="275" y="382" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="238" y="422" width="110" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="360" y="360" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="525" y="375" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="435" y="328" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="TA_di" bpmnElement="TA"><dc:Bounds x="490" y="230" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="630" y="360" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="G2_di" bpmnElement="G2" isMarkerVisible="true"><dc:Bounds x="805" y="375" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="715" y="328" width="100" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="910" y="360" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="G3_di" bpmnElement="G3" isMarkerVisible="true"><dc:Bounds x="1085" y="375" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="1170" y="360" width="120" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="E_di" bpmnElement="E"><dc:Bounds x="1345" y="382" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1308" y="422" width="110" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="311" y="400"/><di:waypoint x="360" y="400"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="480" y="400"/><di:waypoint x="525" y="400"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="550" y="375"/><di:waypoint x="550" y="310"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="490" y="270"/><di:waypoint x="420" y="270"/><di:waypoint x="420" y="360"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="575" y="400"/><di:waypoint x="630" y="400"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="750" y="400"/><di:waypoint x="805" y="400"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="855" y="400"/><di:waypoint x="910" y="400"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="830" y="425"/><di:waypoint x="830" y="490"/><di:waypoint x="1110" y="490"/><di:waypoint x="1110" y="425"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="1030" y="400"/><di:waypoint x="1085" y="400"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="1135" y="400"/><di:waypoint x="1170" y="400"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="1290" y="400"/><di:waypoint x="1345" y="400"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="m1_di" bpmnElement="m1"><di:waypoint x="293" y="100"/><di:waypoint x="293" y="382"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="m2_di" bpmnElement="m2"><di:waypoint x="550" y="230"/><di:waypoint x="550" y="100"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="m3_di" bpmnElement="m3"><di:waypoint x="385" y="100"/><di:waypoint x="385" y="360"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="m4_di" bpmnElement="m4"><di:waypoint x="1230" y="360"/><di:waypoint x="1230" y="100"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
