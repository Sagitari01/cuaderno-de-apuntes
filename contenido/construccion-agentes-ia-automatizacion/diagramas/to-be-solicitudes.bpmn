<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_tobe" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="C_tobe">
<bpmn:participant id="P_sol" name="Persona solicitante"/>
<bpmn:participant id="P_cen" name="Centro comunitario" processRef="Proc_tobe"/>
<bpmn:messageFlow id="m1" name="Solicitud" sourceRef="P_sol" targetRef="S"/><bpmn:messageFlow id="m2" name="Pide aclaración" sourceRef="T3" targetRef="P_sol"/><bpmn:messageFlow id="m3" name="Envía los datos" sourceRef="P_sol" targetRef="T1"/><bpmn:messageFlow id="m4" name="Confirmación o rechazo" sourceRef="T8" targetRef="P_sol"/>
</bpmn:collaboration>
<bpmn:process id="Proc_tobe" isExecutable="false">
<bpmn:laneSet id="LS_tobe"><bpmn:lane id="LA" name="Componente de IA"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="LS" name="Sistema"><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>G2</bpmn:flowNodeRef><bpmn:flowNodeRef>T6</bpmn:flowNodeRef><bpmn:flowNodeRef>T7</bpmn:flowNodeRef><bpmn:flowNodeRef>G3</bpmn:flowNodeRef><bpmn:flowNodeRef>T8</bpmn:flowNodeRef><bpmn:flowNodeRef>E</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="LR" name="Persona revisora"><bpmn:flowNodeRef>T5</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="S" name="Llega solicitud"/>
<bpmn:task id="T1" name="Extraer datos y señalar ambigüedades"/>
<bpmn:task id="T2" name="Validar campos obligatorios"/>
<bpmn:exclusiveGateway id="G1" name="¿Resultado de la validación?"/>
<bpmn:task id="T3" name="Solicitar aclaración"/>
<bpmn:task id="T5" name="Revisar el caso"/>
<bpmn:task id="T4" name="Consultar disponibilidad en el registro oficial"/>
<bpmn:exclusiveGateway id="G2" name="¿Equipo disponible?"/>
<bpmn:task id="T6" name="Registrar reserva (sin duplicados)"/>
<bpmn:task id="T7" name="Registrar rechazo"/>
<bpmn:exclusiveGateway id="G3"/>
<bpmn:task id="T8" name="Enviar confirmación o rechazo"/>
<bpmn:endEvent id="E" name="Solicitud atendida"/>
<bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="T1"/>
<bpmn:sequenceFlow id="f2" sourceRef="T1" targetRef="T2"/>
<bpmn:sequenceFlow id="f3" sourceRef="T2" targetRef="G1"/>
<bpmn:sequenceFlow id="f4" sourceRef="G1" targetRef="T4" name="Completo"/>
<bpmn:sequenceFlow id="f5" sourceRef="G1" targetRef="T3" name="Faltan datos"/>
<bpmn:sequenceFlow id="f6" sourceRef="T3" targetRef="T1"/>
<bpmn:sequenceFlow id="f7" sourceRef="G1" targetRef="T5" name="Ambiguo"/>
<bpmn:sequenceFlow id="f8" sourceRef="T5" targetRef="T2" name="Datos resueltos"/>
<bpmn:sequenceFlow id="f9" sourceRef="T4" targetRef="G2"/>
<bpmn:sequenceFlow id="f10" sourceRef="G2" targetRef="T6" name="Sí"/>
<bpmn:sequenceFlow id="f11" sourceRef="G2" targetRef="T7" name="No"/>
<bpmn:sequenceFlow id="f12" sourceRef="T6" targetRef="G3"/>
<bpmn:sequenceFlow id="f13" sourceRef="T7" targetRef="G3"/>
<bpmn:sequenceFlow id="f14" sourceRef="G3" targetRef="T8"/>
<bpmn:sequenceFlow id="f15" sourceRef="T8" targetRef="E"/>
</bpmn:process>
