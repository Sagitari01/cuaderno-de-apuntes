              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{api_key}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{url_simulador}}/catalogo/api-key?titulo=El faro de papel",
              "host": [
                "{{url_simulador}}"
              ],
              "path": [
                "catalogo",
                "api-key"
              ],
              "query": [
                {
                  "key": "titulo",
                  "value": "El faro de papel"
                }
              ]
            },
            "description": "Pestaña Authorization: tipo API Key, Key = X-API-Key, Value = {{api_key}}, Add to = Header."
          }
        }
      ]
    },
