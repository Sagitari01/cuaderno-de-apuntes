        {
          "name": "2.3 Consultar API Key válida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('acceso: api_key', function () { pm.expect(pm.response.json().acceso).to.eql('api_key'); });",
                  "pm.test('disponibles = 3', function () { pm.expect(pm.response.json().disponibles).to.eql(3); });"
                ]
