{
  "info": {
    "_postman_id": "87b52a2e-9e10-535b-9494-5769daece78c",
    "name": "Biblioteca: acceso seguro al catálogo",
    "description": "Pruebas de API Key, Basic Auth y JWT contra el simulador del catálogo, y consultas al webhook del workflow de n8n.\n\nAntes de empezar: ejecuta `docker compose up -d`, importa el entorno «Biblioteca local (demo)» y selecciónalo. Para la carpeta 5, importa y publica el workflow en n8n.\n\nTodos los valores son ficticios y solo sirven para este ejercicio local.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "token_jwt",
      "value": ""
    },
    {
      "key": "token_vencido",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Preparar",
      "item": [
        {
          "name": "0.1 Comprobar que el simulador está activo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('estado activo', function () { pm.expect(pm.response.json().estado).to.eql('activo'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{url_simulador}}/salud",
              "host": [
                "{{url_simulador}}"
              ],
              "path": [
                "salud"
              ]
            },
            "description": "Debe responder 200 con estado activo."
          }
        },
        {
          "name": "0.2 Reiniciar el registro del simulador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{url_simulador}}/reiniciar",
              "host": [
                "{{url_simulador}}"
              ],
              "path": [
                "reiniciar"
              ]
            },
            "description": "Borra el registro de peticiones que muestra /registro."
          }
        }
      ]
    },
    {
      "name": "1. Sin autenticación",
      "item": [
        {
          "name": "1.1 Consultar endpoint público",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('acceso: publico', function () { pm.expect(pm.response.json().acceso).to.eql('publico'); });",
                  "pm.test('no incluye disponibilidad', function () { pm.expect(JSON.stringify(pm.response.json())).to.not.include('disponibles'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
