    {
      "name": "4. JWT (Bearer Token)",
      "item": [
        {
          "name": "4.1 Solicitar JWT con credenciales válidas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test('token generado (tres partes separadas por puntos)', function () { pm.expect(j.access_token.split('.').length).to.eql(3); });",
                  "pm.test('token_type Bearer y vigencia', function () { pm.expect(j.token_type).to.eql('Bearer'); pm.expect(j.expires_in > 0).to.eql(true); });",
                  "pm.collectionVariables.set('token_jwt', j.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{url_simulador}}/auth/token",
              "host": [
                "{{url_simulador}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "description": "Envía usuario y clave en un JSON. Guarda el token en la variable de colección token_jwt, solo durante la ejecución.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{jwt_usuario}}\",\n  \"clave\": \"{{jwt_clave}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "4.2 Solicitar JWT con clave incorrecta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
