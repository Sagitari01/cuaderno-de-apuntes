    {
      "name": "5. Webhook del workflow de n8n",
      "item": [
        {
          "name": "5.1 Workflow: ruta API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('acceso: api_key', function () { pm.expect(pm.response.json().autenticacion).to.eql('api_key'); });",
                  "pm.test('el catálogo respondió 200', function () { pm.expect(pm.response.json().resultado.disponibles).to.eql(3); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{url_n8n}}/webhook/acceso-seguro",
              "host": [
                "{{url_n8n}}"
              ],
              "path": [
                "webhook",
                "acceso-seguro"
              ]
            },
            "description": "El workflow usa su credencial Header Auth. Aquí no se envía ninguna clave.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"El faro de papel\",\n  \"tipo_autenticacion\": \"api_key\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
