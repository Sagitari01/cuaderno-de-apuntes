                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{url_simulador}}/auth/token",
              "host": [
                "{{url_simulador}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "description": "El simulador no entrega token si la clave no coincide.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{jwt_usuario}}\",\n  \"clave\": \"clave-incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
