# Copia este archivo como .env solo si quieres cambiar algo. Sin .env, el compose usa estos mismos valores.
# TODOS son valores de DEMOSTRACIÓN para un ejercicio local: no los uses en un sistema real.

# Puertos publicados en tu equipo (solo accesibles desde localhost)
N8N_PUERTO=5680
CATALOGO_PUERTO=8091

# Credenciales ficticias que valida el simulador
API_KEY=demo-clave-api-biblioteca
BASIC_USUARIO=lector-demo
BASIC_CLAVE=demo-clave-basic
JWT_USUARIO=lector-demo
JWT_CLAVE=demo-clave-jwt

# Clave con la que el simulador firma los tokens. Solo la conoce el simulador, nunca n8n.
JWT_SECRETO=firma-solo-para-practica
# Segundos de vigencia de cada token
JWT_VIGENCIA=300
