              }
            ],
            "url": "{{baseUrl}}/webhook-test/biblioteca-evento-protegido",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"evento\": \"libro.devuelto\",\n  \"id_evento\": \"DEV-0001\",\n  \"titulo\": \"El faro de papel\",\n  \"sucursal\": \"Centro\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Control de acceso del proxy. Ejecuta solo por 8092 o HTTPS."
          },
          "event": [
