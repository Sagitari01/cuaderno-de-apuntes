          ]
        }
      ],
      "description": "Solo contra el proxy local (8092) o el túnel HTTPS. Comprueba que no se exponen el editor, las rutas no autorizadas ni el método GET."
    }
  ],
  "auth": {
    "type": "noauth"
  }
}
