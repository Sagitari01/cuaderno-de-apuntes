{
  "info": {
    "name": "Biblioteca | Webhooks y túneles HTTPS",
    "description": "Usa la carpeta 1 solo local y antes de proteger. Después configura Header Auth y usa la carpeta 2 local y por HTTPS. La carpeta 3 se prueba exclusivamente contra el proxy o túnel. Introduce un token privado en el valor local de la variable tokenBiblioteca y no lo compartas ni exportes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5682"
    },
    {
      "key": "tokenBiblioteca",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Demostración abierta (solo local)",
      "item": [
        {
          "name": "Evento sin token — antes de proteger",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/webhook/biblioteca-evento-protegido",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"evento\": \"libro.devuelto\",\n  \"id_evento\": \"DEV-0001\",\n  \"titulo\": \"El faro de papel\",\n  \"sucursal\": \"Centro\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Evento confirmado\", () => pm.expect(pm.response.json().id_evento).to.eql(\"DEV-0001\"));",
                  "pm.test(\"Sin cabeceras ni token en respuesta\", () => {const j=pm.response.json(); pm.expect(j).not.to.have.property(\"headers\"); pm.expect(j).not.to.have.property(\"token\");});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Receptor protegido",
      "item": [
        {
          "name": "Sin cabecera",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/webhook/biblioteca-evento-protegido",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"evento\": \"libro.devuelto\",\n  \"id_evento\": \"DEV-0001\",\n  \"titulo\": \"El faro de papel\",\n  \"sucursal\": \"Centro\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Acceso denegado (401 o 403)\", () => pm.expect([401,403]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token incorrecto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Biblioteca-Token",
                "value": "valor-incorrecto-demo"
              }
            ],
            "url": "{{baseUrl}}/webhook/biblioteca-evento-protegido",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"evento\": \"libro.devuelto\",\n  \"id_evento\": \"DEV-0001\",\n  \"titulo\": \"El faro de papel\",\n  \"sucursal\": \"Centro\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Acceso denegado (401 o 403)\", () => pm.expect([401,403]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token válido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Biblioteca-Token",
                "value": "{{tokenBiblioteca}}"
              }
            ],
            "url": "{{baseUrl}}/webhook/biblioteca-evento-protegido",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"evento\": \"libro.devuelto\",\n  \"id_evento\": \"DEV-0001\",\n  \"titulo\": \"El faro de papel\",\n  \"sucursal\": \"Centro\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Evento confirmado\", () => pm.expect(pm.response.json().id_evento).to.eql(\"DEV-0001\"));",
                  "pm.test(\"Sin cabeceras ni token en respuesta\", () => {const j=pm.response.json(); pm.expect(j).not.to.have.property(\"headers\"); pm.expect(j).not.to.have.property(\"token\");});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Frontera del proxy (puerto 8092 o HTTPS)",
      "item": [
        {
          "name": "Editor bloqueado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ruta de prueba bloqueada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/webhook-test/biblioteca-evento-protegido",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"evento\": \"libro.devuelto\",\n  \"id_evento\": \"DEV-0001\",\n  \"titulo\": \"El faro de papel\",\n  \"sucursal\": \"Centro\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Otro webhook bloqueado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/webhook/no-publicar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"evento\": \"libro.devuelto\",\n  \"id_evento\": \"DEV-0001\",\n  \"titulo\": \"El faro de papel\",\n  \"sucursal\": \"Centro\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Método GET bloqueado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/webhook/biblioteca-evento-protegido"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 405\", () => pm.response.to.have.status(405));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
